{
  "name": "bitbucket-contributions",
  "version": "1.0.0",
  "private": true,
  "description": "App self-service para gerar gráfico de contribuições do Bitbucket",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "npm test -- --coverage"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "jest": "^29.7.0"
  }
}
